{
    "crons": [
        { "path": "/api/notifications-cron?action=cron", "schedule": "*/5 * * * *" }
    ],
    "rewrites": [
        {
            "source": "/api/og/:slug",
            "destination": "/api/og/[slug]"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
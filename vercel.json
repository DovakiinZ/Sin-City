{
    "crons": [
        {
            "path": "/api/cron/enforce-email-verification",
            "schedule": "0 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/og/:slug",
            "destination": "/api/og/[slug]"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}